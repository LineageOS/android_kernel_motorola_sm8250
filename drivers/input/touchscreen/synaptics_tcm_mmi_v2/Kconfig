#
# Synaptics TCM touchscreen driver configuration
#

menuconfig TOUCHSCREEN_SYNAPTICS_TCM_MMI
	bool "Synaptics TCM MMI touchscreen"
	default n
	help
	  Say Y here if you have a Moto Synaptics TCM touchscreen connected
	  to your system.

	  If unsure, say N.

if TOUCHSCREEN_SYNAPTICS_TCM_MMI

source "drivers/input/touchscreen/synaptics_tcm_mmi_v2/synaptics_bus/Kconfig"

source "drivers/input/touchscreen/synaptics_tcm_mmi_v2/synaptics_core/Kconfig"

source "drivers/input/touchscreen/synaptics_tcm_mmi_v2/synaptics_extmodules/Kconfig"

endif
