CONFIG_SND_SOC_CS47L35=m
CONFIG_SND_SOC_MADERA=m
CONFIG_EXTCON_MADERA=m
CONFIG_EXTCON_MADERA_INPUT_EVENT=y
CONFIG_MADERA_IRQ=m
CONFIG_SENSORS_CLASS=m
CONFIG_MMI_ANNOTATE=m
CONFIG_MMI_INFO=m
CONFIG_MOTO_F_USBNET=m
CONFIG_TZLOG_DUMP=m
CONFIG_WATCHDOG_CPU_CTX=m
CONFIG_WATCHDOGTEST=m
CONFIG_MMI_RELAY=m
CONFIG_CAMERA_CCI_INTF=m
CONFIG_EXFAT_FS=y
