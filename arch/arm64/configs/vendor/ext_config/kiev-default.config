#
# Please avoid changing the Qualcomm defconfig files and use this file to
# add any Motorola-specific configuration changes that are applicable to
# userdebug, eng, and user builds.
#
# After building, a list of all of the config files that are used can be found
# at the top of:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/mapphone_defconfig
#
# The actual output of the kernel configuration system can be found at:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/.config
#
# You can check the .config file to verify that your configuration option is
# being set as expected.
#
CONFIG_KIEV_DTB=y

CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_PMSG=y
CONFIG_PANEL_NOTIFICATIONS=y
CONFIG_PROC_UID=y
# CONFIG_REGULATOR_PM8008 is not set
# CONFIG_TOUCHSCREEN_ST is not set
# CONFIG_TOUCHSCREEN_ST_I2C is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_I2C is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_CORE is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_RMI_DEV is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_FW_UPDATE is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_FW_UPDATE_EXTRA_SYSFS is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_TEST_REPORTING is not set
# CONFIG_SECURE_TOUCH_SYNAPTICS_DSX is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_I2C is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_CORE is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_TOUCH is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_DEVICE is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_TESTING is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_REFLASH is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_RECOVERY is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_ZEROFLASH is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_DIAGNOSTICS is not set
# CONFIG_TOUCHSCREEN_FTS is not set
# CONFIG_TOUCHSCREEN_FTS_DIRECTORY is not set
# CONFIG_EXTCON_GPIO is not set
# CONFIG_EXTCON_STORAGE_CD_GPIO is not set
CONFIG_LEDS_QPNP_VIBRATOR_LDO=y
CONFIG_NFC_NQ=y
CONFIG_MMC_CLKGATE=y
# CONFIG_MEMORY_HOTPLUG is not set
# CONFIG_MEMORY_HOTPLUG_DEFAULT_ONLINE is not set
# CONFIG_MEMORY_HOTPLUG_MOVABLE_NODE is not set
# CONFIG_MEMORY_HOTREMOVE is not set
# CONFIG_OVERRIDE_MEMORY_LIMIT is not set
# CONFIG_HOTPLUG_SIZE_BITS is not set
# CONFIG_QCOM_MEM_OFFLINE is not set
# CONFIG_UFSHPB is not set
CONFIG_FS_EPOLL_WAKEUP_DEBUG=y
CONFIG_BACKLIGHT_QCOM_SPMI_WLED=y
# CONFIG_THERMAL_STATISTICS is not set
CONFIG_UFSFEATURE=y
CONFIG_UFSTW=y
CONFIG_UFSTW_ENABLE_BY_DEFAULT=y
# CONFIG_UFSTW_IGNORE_GUARANTEE_BIT is not set
# CONFIG_UFSTW_LPM_DISABLED_ON_HIBERN8_FLUSH is not set
CONFIG_SUSPEND_SKIP_SYNC=y
CONFIG_ION_POOL_FILL_MARK=200

CONFIG_INPUT_AWINIC_HAPTIC=y
CONFIG_AW8624_HAPTIC=m
CONFIG_MMI_SYS_TEMP=m
CONFIG_SARSENSOR_SX933X=m
CONFIG_SX933X_USB_CAL=y
CONFIG_SX933X_HEADSET_STATE=y
CONFIG_MOTO_UTAGS=m
CONFIG_TOUCHSCREEN_FTS_0FLASH_MMI=m
CONFIG_INPUT_FOCALTECH_0FLASH_MMI_IC_NAME="ft8756"
CONFIG_INPUT_FOCALTECH_0FLASH_MMI_ENABLE_DOUBLE_TAP=y
CONFIG_INPUT_FOCALTECH_0FLASH_MMI_ENABLE_ESD=y
CONFIG_INPUT_TOUCHSCREEN_MMI=m
CONFIG_TOUCHCLASS_MMI_GESTURE_POISON_EVENT=y
CONFIG_INPUT_QPNP_POWER_ON_MMI=m
CONFIG_INPUT_EGISTEC_FPS=m
CONFIG_INPUT_EGISTEC_FPS_NAVI=y
CONFIG_NAV_DOUBLE_TAP=y
CONFIG_EGIS_DISPLAY_SPEED_UP=y
CONFIG_QPNP_ADAPTIVE_CHARGE=m
CONFIG_QPNP_SMBCHARGER_MMI=m
CONFIG_REGULATOR_WL2864C=m
CONFIG_RADIO_ELNA=m
CONFIG_SENSORS_CLASS=m
CONFIG_MMI_ANNOTATE=m
CONFIG_MMI_INFO=m
CONFIG_MOTO_F_USBNET=m
CONFIG_TZLOG_DUMP=m
CONFIG_WATCHDOG_CPU_CTX=m
CONFIG_WATCHDOGTEST=m
CONFIG_MMI_RELAY=m
CONFIG_MOBICORE_SUPPORT=m
CONFIG_MOBICORE_RSU_INTERNAL_CLOCK=y
CONFIG_CAMERA_CCI_INTF=m
CONFIG_EXFAT_FS=y
